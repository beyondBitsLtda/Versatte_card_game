// Versatte API — Cloudflare Worker (mesmo padrão do Abacato/Proof no beyond-assist)
// SUPABASE_URL fica em vars (não é segredo). Segredos: wrangler secret put SUPABASE_SERVICE_ROLE_KEY
//                                      wrangler secret put VERSATTE_SESSAO_SECRET (já configurado)
{
  "name": "versatte-api",
  // mesma conta do Abacato/Lisa (onde está o domínio beyond.dev.br); id de conta não é segredo
  "account_id": "7e4b10d80b08fef1f2fcca583577bf2d",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // endereço reserva (versatte-api.beyondbitslisa.workers.dev): o app usa se o domínio próprio não responder
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "api-versatte.beyond.dev.br", "custom_domain": true }],
  "vars": {
    // sites que podem chamar a API (o jogo no GitHub Pages e o desenvolvimento local)
    "CORS_ORIGINS": "https://beyondbitsltda.github.io,http://127.0.0.1:8765,http://localhost:8765",
    "SUPABASE_URL": "https://banco.beyond.dev.br"
  },
  "observability": { "enabled": true }
}
